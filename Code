# 7. MAIN CLI & APPLICATION ENTRYPOINT
# ==========================================
if __name__ == "__main__":
    # Check if running within Streamlit CLI
    if st._is_running_with_streamlit:
        run_dashboard()
    else:
        # Standard Terminal / CLI execution
        parser = argparse.ArgumentParser(description="Smart Attendance & Analytics CLI")
