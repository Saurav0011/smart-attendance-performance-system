# 5. AUTHENTICATION MODULE
# ==========================================
USERS_DB = {
    "admin": {"password_hash": hashlib.sha256("admin123".encode()).hexdigest(), "role": "admin"},
    "faculty": {"password_hash": hashlib.sha256("faculty123".encode()).hexdigest(), "role": "faculty"}
}

def authenticate(username, password):
    if username not in USERS_DB:
        return False, None
    hashed = hashlib.sha256(password.encode()).hexdigest()
    if USERS_DB[username]["password_hash"] == hashed:
        return True, USERS_DB[username]["role"]
    return False, None


