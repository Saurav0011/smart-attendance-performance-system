# 6. STREAMLIT INTERACTIVE DASHBOARD UI
# ==========================================
def run_dashboard():
    init_db()
    st.set_page_config(page_title="Smart Attendance & Analytics", layout="wide")
    st.title("🎓 Smart Attendance & Performance Tracking System")

    menu = st.sidebar.selectbox("Navigation Menu", ["Dashboard", "Mark Attendance", "Predict Risk"])

    if menu == "Dashboard":
        st.header("📊 Student Performance & Attendance Analytics")
        
        # Display sample student dataset table
        df = pd.DataFrame({
            "Student ID": ["S101", "S102", "S103", "S104"],
            "Name": ["Rahul Sharma", "Priya Verma", "Ankit Patel", "Sneha Rao"],
            "Attendance (%)": [92.5, 68.0, 45.0, 88.0],
            "Midterm Score": [85.0, 60.0, 38.0, 80.0],
            "Risk Level": ["Low Risk", "Medium Risk", "High Risk", "Low Risk"]
        })
        st.table(df)

    elif menu == "Mark Attendance":
        st.header("📷 Record Attendance")
        student_id = st.text_input("Enter Student ID to Register Attendance:")
        
        if st.button("Mark Present"):
            if student_id.strip():
                success, msg = AttendanceManager.mark_attendance(student_id.strip())
                if success:
                    st.success(f"Success: {msg}")
                else:
                    st.warning(f"Notice: {msg}")
            else:
                st.error("Please enter a valid Student ID.")

    elif menu == "Predict Risk":
        st.header("⚠️ Predict Academic Performance Risk")
        
        att = st.slider("Attendance Percentage (%)", 0.0, 100.0, 75.0)
        assign = st.slider("Assignment Score (out of 100)", 0.0, 100.0, 70.0)
        midterm = st.slider("Midterm Exam Score (out of 100)", 0.0, 100.0, 65.0)
        
        if st.button("Calculate Risk Category"):
            evaluator = PerformanceEvaluator()
            risk = evaluator.predict_risk(att, assign, midterm)
            
            if risk == "Low Risk":
                st.success(f"Evaluation: {risk}")
            elif risk == "Medium Risk":
                st.warning(f"Evaluation: {risk}")
            else:
                st.error(f"Evaluation: {risk}")


