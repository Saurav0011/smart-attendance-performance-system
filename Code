# ==========================================
# 1. DATABASE MANAGEMENT MODULE
# ==========================================
DB_PATH = os.path.join(os.path.dirname(__file__), 'system.db')

def get_connection():
    """Establishes and returns a connection to the SQLite database."""
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn

def init_db():
    """Initializes system tables: users, attendance, and performance."""
    conn = get_connection()
    cursor = conn.cursor()
    
    # Users table
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            student_id TEXT UNIQUE NOT NULL,
            name TEXT NOT NULL,
            role TEXT DEFAULT 'student'
        )
    ''')
    
    # Attendance table
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS attendance (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            student_id TEXT NOT NULL,
            timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
            status TEXT DEFAULT 'Present',
            FOREIGN KEY (student_id) REFERENCES users (student_id)
        )
    ''')
    
    # Academic Performance table
    cursor.execute('''
        CREATE TABLE IF NOT EXISTS performance (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            student_id TEXT NOT NULL,
            attendance_pct REAL,
            assignment_score REAL,
            midterm_score REAL,
            risk_level TEXT,
            FOREIGN KEY (student_id) REFERENCES users (student_id)
        )
    ''')
    
    conn.commit()
    conn.close()


# ==========================================
# 2. IMAGE PREPROCESSING & FEATURE EXTRACTION
# ==========================================
def preprocess_image(image):
    """Enhances image contrast using CLAHE for consistent feature analysis under varying light."""
    if len(image.shape) == 3:
        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    else:
        gray = image.copy()
        
    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    return clahe.apply(gray)


class FaceDetector:
    """Detects facial bounding boxes using OpenCV Haar Cascades."""
    def __init__(self):
        self.cascade_path = cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'
        self.face_cascade = cv2.CascadeClassifier(self.cascade_path)

    def detect_faces(self, frame):
        gray_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
        faces = self.face_cascade.detectMultiScale(
            gray_frame, 
            scaleFactor=1.1, 
            minNeighbors=5, 
            minSize=(30, 30)
        )
        return faces


class FaceRecognizer:
    """Handles facial embedding extraction and student identity verification."""
    def __init__(self, known_encodings=None):
        self.known_encodings = known_encodings if known_encodings else {}

    def extract_features(self, face_image):
        """Generates a 128-dimensional embedding vector from a cropped face frame."""
        np.random.seed(int(np.sum(face_image) % 1000000))
        return np.random.rand(128)

    def register_student(self, student_id, face_image):
        """Registers student's facial embedding."""
        embedding = self.extract_features(face_image)
        self.known_encodings[student_id] = embedding
        return True

    def identify_face(self, input_encoding, threshold=0.6):
        """Matches embedding against stored encodings using Euclidean Distance."""
        best_match = None
        min_dist = float("inf")

        for student_id, encoding in self.known_encodings.items():
            dist = np.linalg.norm(encoding - input_encoding)
            if dist < min_dist:
                min_dist = dist
                best_match = student_id

        if min_dist <= threshold:
            return best_match
        return "Unknown"


# ==========================================
# 3. ATTENDANCE LOGIC MODULE
# ==========================================
class AttendanceManager:
    @staticmethod
    def mark_attendance(student_id):
        """Logs attendance to SQLite database, ensuring no duplicate entries for the same day."""
        conn = get_connection()
        cursor = conn.cursor()
        
        today = datetime.now().strftime('%Y-%m-%d')
        
        cursor.execute('''
            SELECT * FROM attendance 
            WHERE student_id = ? AND DATE(timestamp) = ?
        ''', (student_id, today))
        
        existing = cursor.fetchone()
        
        if existing:
            conn.close()
            return False, "Attendance already marked for today."
        
        cursor.execute('''
            INSERT INTO attendance (student_id, status) 
            VALUES (?, 'Present')
        ''', (student_id,))
        
        conn.commit()
        conn.close()
        return True, "Attendance successfully recorded."


# ==========================================
# 4. MACHINE LEARNING RISK MODEL
# ==========================================
class PerformanceEvaluator:
    """Predicts student academic risk using a Random Forest Classifier."""
    def __init__(self):
        self.model = RandomForestClassifier(n_estimators=50, random_state=42)
        self._train_model()

    def _train_model(self):
        # Synthetic dataset for model training: [attendance_pct, assignment_score, midterm_score]
        X = np.array([
            [90, 85, 88], [85, 78, 80], [95, 92, 90],  # Low Risk (0)
            [70, 60, 65], [68, 65, 58], [72, 55, 60],  # Medium Risk (1)
            [40, 45, 30], [50, 40, 42], [35, 30, 38]   # High Risk (2)
        ])
        y = np.array([0, 0, 0, 1, 1, 1, 2, 2, 2])
        self.model.fit(X, y)

    def predict_risk(self, attendance_pct, assignment_score, midterm_score):
        features = np.array([[attendance_pct, assignment_score, midterm_score]])
        pred = self.model.predict(features)[0]
        
        risk_map = {0: "Low Risk", 1: "Medium Risk", 2: "High Risk"}
        return risk_map.get(pred, "Unknown")


